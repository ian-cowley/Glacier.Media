<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>Glacier.Media</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Pure C# .NET 10 Generative Multimodal Media engine featuring FLUX.1 Flow-Matching DiT, Wan 2.1 3D Spatio-Temporal Video DiT, KittenTTS Neural Speech Synthesis, Kokoro TTS, Whisper STT, and 2D Spatial Multimodal Projectors.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Media</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Media.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>media;diffusion;dit;flux;wan;video;image;tts;stt;kittentts;kokoro;whisper;vision;multimodal;simd;net10;aot;glacier</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="Exists('../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj') and '$(UseLocalProjectReferences)' != 'false'">
    <ProjectReference Include="../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj') or '$(UseLocalProjectReferences)' == 'false'">
    <PackageReference Include="Glacier.Inference" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glacier.Media.Tests" />
  </ItemGroup>
</Project>
